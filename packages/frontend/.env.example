# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; this template is committed.

# WalletConnect Cloud project ID, used by RainbowKit for QR and mobile wallet connections.
# Get one at https://cloud.walletconnect.com
#
# Optional for local development: if unset, the app falls back to a shared public demo ID,
# which is enough for browser-extension wallets on the local Hardhat chain. Set your own
# before distributing a build.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
